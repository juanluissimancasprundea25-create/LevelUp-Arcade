# ============================================================
# LevelUp Arcade - Plantilla de variables de entorno
# Copia este fichero a .env y rellena los valores reales
# El fichero .env NUNCA se sube al repositorio (está en .gitignore)
# ============================================================

# --- Base de datos PostgreSQL ---
DB_NAME=levelup
DB_USER=levelup_user
DB_PASSWORD=cambiame_en_local

# --- JWT (genera una clave aleatoria de mínimo 32 caracteres) ---
JWT_SECRET=cambia_esto_por_una_clave_aleatoria_larga_de_minimo_32_caracteres
JWT_EXPIRATION_MS=86400000

# --- OpenRouter (LLM) ---
# Obtén tu API key en https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-pon-aqui-tu-clave
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# --- Email (para recuperar contraseña con Gmail App Password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-16-caracteres

# --- Google reCAPTCHA v3 ---
RECAPTCHA_SITE_KEY=clave-publica-de-recaptcha
RECAPTCHA_SECRET=clave-secreta-de-recaptcha

# --- pgAdmin (gestor visual de Postgres en http://localhost:5050) ---
PGADMIN_EMAIL=admin@leveluparcade.local
PGADMIN_PASSWORD=admin