# ============================================================
# LevelUp Arcade - Plantilla de variables de entorno
# Copia este fichero a .env y rellena los valores reales
# El fichero .env NUNCA se sube al repositorio (esta en .gitignore)
# ============================================================

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=levelup
DB_USER=levelup_user
DB_PASSWORD=cambiame_en_local

# --- JWT (genera una clave aleatoria de minimo 32 caracteres) ---
# Para generarla: openssl rand -base64 32
JWT_SECRET=cambia_esto_por_una_clave_aleatoria_larga_de_minimo_32_caracteres
JWT_EXPIRATION_MS=86400000

# --- OpenRouter (LLM) ---
# Obten tu API key en https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-v1-pon-aqui-tu-clave
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# --- Email (para recuperar contrasena con Gmail App Password) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-app-password-de-16-caracteres

# --- Google reCAPTCHA v3 ---
RECAPTCHA_SITE_KEY=clave-publica-de-recaptcha
RECAPTCHA_SECRET=clave-secreta-de-recaptcha

# --- pgAdmin (gestor visual de Postgres en http://localhost:5050) ---
# IMPORTANTE: pgadmin4 rechaza dominios reservados como .local
# Usa un dominio real (.com, .org, .es...) aunque sea ficticio.
PGADMIN_EMAIL=admin@leveluparcade.com
PGADMIN_PASSWORD=admin123